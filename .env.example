# Conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/funeralcontrol
DATABASE_SSL=false

# Usuário Administrador Inicial (criado automaticamente na inicialização)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin

# Diretório para armazenamento dos contratos digitalizados
CONTRACTS_DIR=./uploads/contracts
